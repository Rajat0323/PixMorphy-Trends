NEXT_PUBLIC_SITE_URL=https://www.pixmorphy.in
# Fill Neon-managed values with `neon env pull`; never commit the resulting credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_FUNCTION_HELLO_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate-with-npm-run-cms:password-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-separate-long-random-secret
# Optional fallback only; Neon Object Storage is preferred when its AWS_* vars exist.
BLOB_READ_WRITE_TOKEN=
